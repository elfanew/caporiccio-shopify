{% if product != blank %}
  {%- unless product.has_only_default_variant -%}
    <variant-set-option
      class="block product-variant-selector main-product-variant-selector"
      {{ block.shopify_attributes }}
      data-url="{{ product.url }}"
      data-section="{{ section.id }}"
      data-page="{{ template }}"
      data-type="{{ settings.option_style }}"
    >
      {%- for option in product.options_with_values -%}
        {%- liquid
          assign color_options = settings.colorname | downcase
          assign size_options_name = settings.sizename | downcase
          assign option_name = option.name | downcase
          assign index_value = forloop.index
          
          # LOGICA DINAMICA GUIDA TAGLIE (Tua personalizzazione)
          assign custom_size_guide = product.metafields.custom.guida_alle_taglie.value
          assign size_guide_content = custom_size_guide.contenuto
        -%}

        <fieldset class="product-variant--picker {% if color_options contains option_name %}product-swatch color-swatch--wide{% else %}product-select--box{% endif %}">
          <legend class="product-variant--text {{ settings.labels_font }}-font">
            <div>
              <strong>{{ option.name -}}</strong>:
              <span
                class="selected-value-{{ section.id }}-{{ forloop.index }}"
                data-slected-value
                data-type-name="{{ option.name -}}"
                data-option-name="{{ option.name -}} / {{ option.selected_value }}"
              >
                {{- option.selected_value -}}
              </span>
            </div>

            {%- comment -%} RIPRISTINO COMPONENTE ORIGINALE GUIDA TAGLIE {%- endcomment -%}
            {% if block.settings.enable_size_chart and block.settings.size_chart != blank %}
              {%- liquid
                if size_options_name contains option_name
                  render 'size-chart', block: block, size_option: option_name
                endif
              -%}
            {% endif %}
          </legend>

          {% if settings.option_style == 'swatch' %}
            <ul>
              {%- for value in option.values -%}
                {% liquid
                  # FILTRO TAGLIE ESAURITE
                  assign is_available = false
                  for variant in product.variants
                    if variant.options contains value and variant.available
                      assign is_available = true
                      break
                    endif
                  endfor

                  assign variant_option = 'option' | append: option.position
                  assign variant_value = product.variants | where: variant_option, value | compact: 'featured_media' | first

                  if value.swatch.image
                    assign image_url = value.swatch.image | image_url: width: 50
                    assign swatch_value = 'background-image: url(' | append: image_url | append: ')'
                  elsif value.swatch.color
                    assign swatch_value = '--background-color-swatch: rgb(' | append: value.swatch.color.rgb | append: ')'
                  else
                    assign swatch_value = null
                  endif
                -%}

                {% if is_available %}
                  <li class="product-variant--item swatch-color swatch-{{ settings.swatches_style }} product-swatch-item">
                    <input
                      class="product-swatch-option"
                      id="product-{{ product.id }}_option-{{ section.id }}-{{ forloop.index }}-{{ block.id }}-{{ value | handle }}"
                      type="radio"
                      name="color-option-{{ index_value }}"
                      form="{{ product_form_id }}"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                    >
                    <span
                      class="swatch-variant-item {% if color_options contains option_name %}swatch-variant-color {% if variant_value and settings.show_variant_image %} swatch-variant-img{% endif %} {% endif %}"
                      {% if variant_value and settings.show_variant_image %}
                        style="background-image:url({{ variant_value.featured_media.preview_image | image_url: width: 22 }});"
                      {% else %}
                        {% if swatch_value != null -%}
                          style="{{ swatch_value }};"
                        {% else %}
                          style="--background-color-swatch:{{ value }};"
                        {% endif %}
                      {% endif %}
                    >
                      {% unless color_options contains option_name -%}{{- value -}}{%- endunless -%}
                    </span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% else %}
            <div class="variant-selecter">
               <svg width="9" height="7" class="icon icon-chevron-bottom" viewBox="0 0 10 7">
                  <path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
               </svg>
              <select class="options-select select-option-box" name="{{ option.name }}" form="{{ product_form_id }}">
                {% for value in option.values %}
                  {% liquid
                    assign is_available = false
                    for variant in product.variants
                      if variant.options contains value and variant.available
                        assign is_available = true
                        break
                      endif
                    endfor
                  %}
                  {% if is_available %}
                    <option {% if option.selected_value == value %}selected{% endif %} value="{{ value }}">
                      {{- value -}}
                    </option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>
          {% endif %}
        </fieldset>
      {% endfor %}
    </variant-set-option>
  {% endunless %}

  <noscript>
    <div class="product-variant--item">
      <p class="variant-title">{{ 'products.product.product_variants' | t }}</p>
      <div class="select-box">
        <select class="form-control" name="id" form="{{ product_form_id }}">
          {%- for variant in product.variants -%}
            <option
              {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
              {% if variant.available == false %}disabled{% endif %}
              value="{{ variant.id }}"
            >
              {{ variant.title }} - {{ variant.price | money }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>
  </noscript>
{% endif %}